{
    "experiment_name": "rf_sliding_raw_1s",
    "data_root": "data/keypoints",
    "coordinate_field": "keypoints",
    "coordinate_channels": [
        0,
        1
    ],
    "visibility_filter": true,
    "visibility_threshold": 0.3,
    "fps": 30.0,
    "window_seconds": 1.0,
    "window_size_frames": 30,
    "window_stride": 1,
    "missing_value_strategy": "interpolate",
    "number_of_videos": 70,
    "number_of_windows": 8993,
    "feature_dimension": 1980,
    "folds": 5,
    "random_state": 42,
    "n_estimators": 500,
    "max_features": "sqrt",
    "class_weight": "balanced",
    "n_jobs": 8
}