{
  "data_root": "data/keypoints_ur",
  "windows_cache": "data/windows/keypoints_ur_windows.npz",
  "output_root": "results_ur",
  "window_size": 30,
  "stride": 1,
  "missing_mode": "interp",
  "visibility_threshold": 0.3,
  "hidden": [
    256,
    64
  ],
  "dropout": 0.3,
  "epochs": 100,
  "patience": 12,
  "batch_size": 64,
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "folds": 5,
  "seed": 42,
  "device": "cuda:1",
  "experiment_output_dir": "results_ur/mlp",
  "annotation_csv": "data/urfall-cam0-falls.csv",
  "label_level": "window",
  "urfall_window_label_rule": "ignore_0_then_majority_vote_-1_vs_1"
}