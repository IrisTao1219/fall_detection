{
  "data_root": "data/keypoints",
  "output_root": "results",
  "window_size": 30,
  "stride": 1,
  "missing_mode": "interp",
  "visibility_threshold": 0.3,
  "dropout": 0.3,
  "epochs": 100,
  "patience": 12,
  "batch_size": 64,
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "folds": 5,
  "seed": 42,
  "device": "cuda:2",
  "experiment_output_dir": "results/fall_adaptive_stgcn",
  "model_type": "fall_adaptive_stgcn",
  "feature_mode": "xy66",
  "channels": [
    64,
    64,
    64,
    64,
    128,
    128,
    128,
    256,
    256,
    256
  ],
  "temporal_kernel_size": 9,
  "adaptive_graph": true,
  "fall_aware_joints": [
    11,
    12,
    23,
    24,
    25,
    26,
    27,
    28
  ],
  "adaptive_graph_formula": "A_physical + alpha*A_fall_prior + beta*tanh(A_learnable)",
  "pose_extractor": "BlazePose",
  "annotation_csv": "data/urfall-cam0-falls.csv",
  "label_level": "window",
  "urfall_window_label_rule": "ignore_0_then_majority_vote_-1_vs_1"
}